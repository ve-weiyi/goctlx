.PHONY: help deps gen-model-dsn gen-model-ddl gen-web-ts-app gen-web-ts-admin gen-web-ts-swagger gen-api-gin-app gen-api-gin-admin gen-api-gin-app-swagger gen-api-gin-admin-swagger clean

# ======== 可配置变量（测试环境） ========

# Model 生成
DSN         := root:your-password@(localhost:3306)/veweiyi-blog?charset=utf8mb4&parseTime=True&loc=Local
SQL_FILE    := ./testdata/test.sql
MODEL_TPL   := ./template/model/model.tpl
MODEL_OUT   := ./runtime/model

# TypeScript 生成
APP_API_FILE     := ./testdata/test.api
ADMIN_API_FILE   := ./testdata/test.api
APP_SWAGGER_FILE := ./testdata/test.json
TS_APP_OUT       := ./runtime/web/ts
TS_ADMIN_OUT     := ./runtime/web/ts

# Gin API 生成
GIN_TPL         := ./template/api/gin
SVCTX_PACKAGE   := github.com/example/svctx
GIN_APP_OUT     := ./runtime/gin/app
GIN_ADMIN_OUT   := ./runtime/gin/admin

# ======== 命令 ========

help:
	@echo "可用命令（请修改上方变量后使用）："
	@echo "  deps                         - 安装依赖"
	@echo "  gen-model-dsn                - 从数据库生成 GORM 模型"
	@echo "  gen-model-ddl                - 从 SQL 文件生成 GORM 模型"
	@echo "  gen-web-ts-app               - 生成 TypeScript API（app）"
	@echo "  gen-web-ts-admin             - 生成 TypeScript API（admin）"
	@echo "  gen-web-ts-swagger           - 从 swagger.json 生成 TypeScript"
	@echo "  gen-api-gin-app              - 从 .api 文件生成 Gin API（app）"
	@echo "  gen-api-gin-admin            - 从 .api 文件生成 Gin API（admin）"
	@echo "  gen-api-gin-app-swagger      - 从 swagger.json 生成 Gin API（app）"
	@echo "  gen-api-gin-admin-swagger    - 从 swagger.json 生成 Gin API（admin）"
	@echo "  clean                        - 清理生成的代码"

deps:
	go mod tidy

# ======== Model 生成 ========

gen-model-dsn:
	go run main.go model mysql dsn \
		-u "$(DSN)" \
		-t $(MODEL_TPL) \
		-o $(MODEL_OUT) \
		-n "%s_model.go"

gen-model-ddl:
	go run main.go model mysql ddl \
		-s $(SQL_FILE) \
		-t $(MODEL_TPL) \
		-o $(MODEL_OUT) \
		-n '%v_model.go'

# ======== TypeScript 生成 ========

gen-web-ts-app:
	go run main.go web ts api \
		-f $(APP_API_FILE) \
		-o $(TS_APP_OUT)

gen-web-ts-admin:
	go run main.go web ts api \
		-f $(ADMIN_API_FILE) \
		-o $(TS_ADMIN_OUT)

gen-web-ts-swagger:
	go run main.go web ts swagger \
		-f $(APP_SWAGGER_FILE) \
		-o $(TS_APP_OUT)

# ======== Gin API 生成 ========

gen-api-gin-app:
	go run main.go api gin api \
		-f $(APP_API_FILE) \
		-t $(GIN_TPL) \
		-o $(GIN_APP_OUT) \
		-c $(SVCTX_PACKAGE)

gen-api-gin-admin:
	go run main.go api gin api \
		-f $(ADMIN_API_FILE) \
		-t $(GIN_TPL) \
		-o $(GIN_ADMIN_OUT) \
		-c $(SVCTX_PACKAGE)

gen-api-gin-app-swagger:
	go run main.go api gin swagger \
		-f $(APP_SWAGGER_FILE) \
		-t $(GIN_TPL) \
		-o $(GIN_APP_OUT) \
		-c $(SVCTX_PACKAGE)

gen-api-gin-admin-swagger:
	go run main.go api gin swagger \
		-f $(APP_SWAGGER_FILE) \
		-t $(GIN_TPL) \
		-o $(GIN_ADMIN_OUT) \
		-c $(SVCTX_PACKAGE)

clean:
	rm -rf ./runtime
